nextflow.enable.dsl = 2

env {
    R_LIBS_USER    = 'FALSE'
    R_PROFILE_USER = 'FALSE'
    R_ENVIRON_USER = 'FALSE'
}

params {
    outdir        = "results"
    threads       = 10
    design        = null
    reads         = null
    compress      = true
    snp_info      = null
    identity_amplicon  = null
    min_mapq      = 20
}


/*
 * Default process settings.
 *
 * These apply when running locally, for example:
 *
 *   nextflow run main.nf -profile conda
 *
 * They also act as defaults that can be overridden by
 * execution-specific profiles such as LSF.
 */
process {

    cpus = 1

    /*
     * Local/default behaviour:
     * stop the workflow immediately if a process fails.
     */
    errorStrategy = 'terminate'

    withName: ALIGN_BWA_MEM {
        cpus = params.threads
    }

    withName: BUILD_REFERENCE {
        cpus = 2
    }

    withName: FASTQC {
        cpus = 2
    }

    withName: QC_PLOTS {
        cpus = 1
    }

    withName: EXTRACT_AMPLICON_TSV {
        cpus = 1
    }

    withName: EXTRACT_READ_MUTATION {
        cpus = 1
        maxForks = 1
    }

    withName: REPORT_identity_AMPLICON {
        cpus = 1
    }
}


profiles {

    /*
     * Conda profile
     *
     * Enables the process-specific Conda environments
     * defined in the workflow modules.
     *
     * Usage:
     *   nextflow run main.nf -profile conda
     */
    conda {
        conda.enabled = true
    }


    /*
     * LSF / HPC profile
     *
     * Usage together with Conda:
     *   nextflow run main.nf -profile conda,lsf
     */
    lsf {

        process {

            executor = 'lsf'

            /*
             * Retry selected failures that may be caused by
             * transient cluster/scheduler problems.
             *
             * Other failures use 'finish': no new tasks are
             * submitted, but already-running tasks are allowed
             * to finish.
             */
            errorStrategy = {
                task.exitStatus in [104, 134, 135, 137, 139, 143] ?
                    'retry' :
                    'finish'
            }

            maxRetries = 2
            maxErrors  = '-1'


            withName: GET_AMPLICON_SEQ {
                cpus = 1
                memory = '2 GB'
            }

            withName: GET_AMPLICON_IDS {
                cpus = 1
                memory = '2 GB'
            }

            withName: JOIN_DESIGN_AND_SNP {
                cpus = 1
                memory = '2 GB'
            }

            withName: MAKE_AMPLICON_LIST {
                cpus = 1
                memory = '2 GB'
            }

            withName: BUILD_REFERENCE {
                cpus = 2
                memory = '10 GB'
            }

            withName: EXTRACT_READNAMES {
                cpus = 1
                memory = '4 GB'
            }

            withName: FASTQC {
                cpus = 2
                memory = '4 GB'
            }

            withName: ALIGN_BWA_MEM {
                cpus = 12
                memory = '50 GB'
            }

            withName: QC_PLOTS {
                cpus = 1
                memory = '10 GB'
            }

            withName: EXTRACT_AMPLICON_TSV {
                cpus = 1
                memory = '2 GB'
            }

            withName: EXTRACT_READ_MUTATION {
                cpus = 1
                memory = '150 GB'
                maxForks = 1
            }

            withName: REPORT_identity_AMPLICON {
                cpus = 1
                memory = '40 GB'
            }
        }

        executor {
            perJobMemLimit = true
            queueSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }
    }
}

