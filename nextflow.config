nextflow.enable.dsl = 2


env {
    R_LIBS_USER    = 'FALSE'
    R_PROFILE_USER = 'FALSE'
    R_ENVIRON_USER = 'FALSE'
}


params {
    outdir             = "results"
    threads            = 10
    design             = null
    reads              = null
    compress           = true
    snp_info           = null
    identity_amplicon  = null
    min_mapq           = 20
}


/*
 * Default process settings
 *
 * Used for local execution, e.g.:
 *
 *   nextflow run main.nf -profile conda
 *
 * These also provide defaults that can be overridden
 * by the LSF profile below.
 */
process {

    cpus = 1

    /*
     * Local/default behaviour:
     * terminate immediately if a process fails.
     */
    errorStrategy = 'terminate'


    withName: ALIGN_BWA_MEM {
        cpus = params.threads
    }


    withName: BUILD_REFERENCE {
        cpus = 2
    }


    withName: FASTQC {
        cpus = 2
    }


    withName: MULTIQC {
        cpus = 1
    }


    withName: QC_PLOTS {
        cpus = 1
    }


    withName: EXTRACT_AMPLICON_TSV {
        cpus = 1
    }


    withName: EXTRACT_READ_MUTATION {
        cpus = 1
        maxForks = 1
    }


    withName: REPORT_identity_AMPLICON {
        cpus = 1
    }
}


/*
 * Execution profiles
 */
profiles {


    /*
     * Conda profile
     *
     * Enables the process-specific Conda environments
     * declared inside the workflow modules.
     *
     * Usage:
     *
     *   nextflow run main.nf -profile conda
     */
    conda {

        conda.enabled = true

        /*
         * Optional but useful on Farm if environment creation
         * takes a long time.
         */
        conda.createTimeout = '120 min'
    }


    /*
     * LSF / HPC profile
     *
     * Usually used together with Conda:
     *
     *   nextflow run main.nf -profile conda,lsf
     */
    lsf {

        process {

            executor = 'lsf'


            /*
             * Retry selected failures that may reflect
             * transient scheduler/node failures.
             *
             * Other failures use 'finish':
             * no new tasks are submitted, but already-running
             * tasks are allowed to finish.
             */
            errorStrategy = {
                task.exitStatus in [
                    104,
                    134,
                    135,
                    137,
                    139,
                    143
                ] ? 'retry' : 'finish'
            }

            maxRetries = 2
            maxErrors  = '-1'


            /*
             * Design / metadata steps
             */
            withName: GET_AMPLICON_SEQ {
                cpus = 1
                memory = '2 GB'
            }


            withName: GET_AMPLICON_IDS {
                cpus = 1
                memory = '2 GB'
            }


            withName: JOIN_DESIGN_AND_SNP {
                cpus = 1
                memory = '2 GB'
            }


            withName: MAKE_AMPLICON_LIST {
                cpus = 1
                memory = '2 GB'
            }


            /*
             * Reference construction
             */
            withName: BUILD_REFERENCE {
                cpus = 2
                memory = '10 GB'
            }


            /*
             * Read-name / barcode extraction
             */
            withName: EXTRACT_READNAMES {
                cpus = 1
                memory = '4 GB'
            }


            /*
             * Read QC
             */
            withName: FASTQC {
                cpus = 2
                memory = '4 GB'
            }


            /*
             * Aggregate FastQC results
             */
            withName: MULTIQC {
                cpus = 1
                memory = '4 GB'
            }


            /*
             * Alignment
             */
            withName: ALIGN_BWA_MEM {
                cpus = 12
                memory = '50 GB'
            }


            /*
             * Alignment QC
             */
            withName: QC_PLOTS {
                cpus = 1
                memory = '10 GB'
            }


            /*
             * Extract per-amplicon alignment tables
             */
            withName: EXTRACT_AMPLICON_TSV {
                cpus = 1
                memory = '2 GB'
            }


            /*
             * Fragment mutation extraction
             *
             * Current memory allocation is based on the
             * observed ~129 GB peak RSS from AMPL902649.
             */
            withName: EXTRACT_READ_MUTATION {
                cpus = 1
                memory = '150 GB'
                maxForks = 1
            }


            /*
             * Identity amplicon reporting
             */
            withName: REPORT_identity_AMPLICON {
                cpus = 1
                memory = '40 GB'
            }
        }


        /*
         * LSF executor behaviour
         */
        executor {

            /*
             * Treat process memory as a per-job memory request.
             */
            perJobMemLimit = true

            /*
             * Maximum number of LSF child jobs Nextflow keeps
             * submitted/outstanding at once.
             */
            queueSize = 4

            /*
             * Avoid submitting jobs too rapidly.
             */
            submitRateLimit = '5 sec'

            /*
             * Number of jobs killed together if Nextflow needs
             * to terminate outstanding work.
             */
            killBatchSize = 50
        }
    }
}

