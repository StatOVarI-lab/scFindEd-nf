nextflow.enable.dsl = 2

env {
    R_LIBS_USER    = 'FALSE'
    R_PROFILE_USER = 'FALSE'
    R_ENVIRON_USER = 'FALSE'
}

params {
    outdir        = "results"
    threads       = 10
    design        = null
    reads         = null
    compress      = true
    snp_info      = null
    utr_amplicon  = null
    min_mapq      = 20
}

process {

    errorStrategy = 'terminate'
    cpus = 1

    withName: ALIGN_BWA_MEM {
        cpus = params.threads
    }

    withName: BUILD_REFERENCE {
        cpus = 2
    }

    withName: QC_PLOTS {
        cpus = 1
    }

    withName: EXTRACT_AMPLICON_TSV {
        cpus = 1
    }

    withName: EXTRACT_READ_MUTATION {
        cpus = 1
        maxForks = 1
    }

    withName: REPORT_UTR_AMPLICON {
        cpus = 1
    }
}

profiles {

    conda {
        conda.enabled = true
    }

    lsf {

        process {

            executor = 'lsf'

            withName: GET_AMPLICON_SEQ {
                cpus = 1
                memory = '2 GB'
            }

            withName: GET_AMPLICON_IDS {
                cpus = 1
                memory = '2 GB'
            }

            withName: JOIN_DESIGN_AND_SNP {
                cpus = 1
                memory = '2 GB'
            }

            withName: MAKE_AMPLICON_LIST {
                cpus = 1
                memory = '2 GB'
            }

            withName: BUILD_REFERENCE {
                cpus = 2
                memory = '10 GB'
            }

            withName: EXTRACT_READNAMES {
                cpus = 1
                memory = '4 GB'
            }

            withName: ALIGN_BWA_MEM {
                cpus = 12
                memory = '50 GB'
            }

            withName: QC_PLOTS {
                cpus = 1
                memory = '10 GB'
            }

            withName: EXTRACT_AMPLICON_TSV {
                cpus = 1
                memory = '2 GB'
            }

            withName: EXTRACT_READ_MUTATION {
                cpus = 1
                memory = '150 GB'
                maxForks = 1
            }

            withName: REPORT_UTR_AMPLICON {
                cpus = 1
                memory = '40 GB'
            }
        }

        executor {
            perJobMemLimit = true
            queueSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }

        errorStrategy = {
            task.exitStatus in [104, 134, 135, 137, 139, 143] ? 'retry' : 'finish'
        }

        maxRetries = 2
        maxErrors = '-1'
    }
}

