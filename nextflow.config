nextflow.enable.dsl=2

env {
  R_LIBS_USER = 'FALSE'
  R_PROFILE_USER = 'FALSE'
  R_ENVIRON_USER = 'FALSE'
}

params {
  outdir  = "results"
  threads = 10
  design  = null
  reads   = null
  compress = true
  snp_info = null
  utr_amplicon = null
  min_mapq = 20
}

process {
  executor = 'local'
  errorStrategy = 'terminate'
  cpus = 1

  withName: ALIGN_BWA_MEM {
    cpus = params.threads
  }

  withName: BUILD_REFERENCE {
    cpus = 2
  }

  withName: QC_PLOTS {
    cpus = 1
  }

  withName: EXTRACT_AMPLICON_TSV {
    cpus = 1
  }

 withName: EXTRACT_READ_MUTATION {
    cpus = 1
    maxForks = 1
  }
}

profiles {
  conda {
    conda.enabled = true
  }
}

